    <!-- ==================== JavaScript ==================== -->
    <script>
      (function () {
        const filterButtons = document.querySelectorAll(".filter-btn");
        const galleryItems = document.querySelectorAll(".gallery-item");
        const TRANSITION_MS = 320;

        function applyFilter(filterValue) {
          galleryItems.forEach(function (item, index) {
            const matches =
              filterValue === "all" || item.dataset.category === filterValue;
            const isVisible = !item.classList.contains("is-hidden");

            if (matches && !isVisible) {
              // reveal: unhide then animate in on next frame
              item.classList.remove("is-hidden");
              item.classList.add("is-entering");
              requestAnimationFrame(function () {
                setTimeout(
                  function () {
                    item.classList.remove("is-entering");
                  },
                  20 + index * 15,
                );
              });
            } else if (!matches && isVisible) {
              // hide: fade/scale out, then remove from grid flow
              item.classList.add("is-leaving");
              setTimeout(function () {
                item.classList.add("is-hidden");
                item.classList.remove("is-leaving");
              }, TRANSITION_MS);
            } else if (matches && isVisible) {
              // already visible and staying visible — no-op, keeps layout stable
            }
          });
        }

        filterButtons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            filterButtons.forEach(function (b) {
              b.classList.remove("active");
            });
            btn.classList.add("active");
            applyFilter(btn.dataset.filter);
          });
        });
      })();
    </script>
